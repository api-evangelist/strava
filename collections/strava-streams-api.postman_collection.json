      "id": "4fd8a154-0410-4ef6-9fcc-f83b9d59793d",
      "name": "Streams",
      "description": {
        "content": "Access time-series data streams for activities and segments, including GPS coordinates, heart rate, power, cadence, speed, and altitude.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3a705e87-f255-43c2-9808-2e8fa5ec2b24",
          "name": "Get Activity Streams",
          "request": {
            "name": "Get Activity Streams",
            "description": {
              "content": "Returns the given activity's streams. Streams are a sequential array of data points for a given activity or segment. Available stream types include: time, latlng, distance, altitude, velocity_smooth, heartrate, cadence, watts, temp, moving, grade_smooth.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "activities",
                ":id",
                "streams"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "keys",
                  "value": "<string>",
                  "description": "(Required) Desired stream types (comma-separated): time, latlng, distance, altitude, velocity_smooth, heartrate, cadence, watts, temp, moving, grade_smooth"
                },
                {
                  "disabled": false,
                  "key": "keys",
                  "value": "<string>",
                  "description": "(Required) Desired stream types (comma-separated): time, latlng, distance, altitude, velocity_smooth, heartrate, cadence, watts, temp, moving, grade_smooth"
                },
                {
                  "disabled": false,
                  "key": "key_by_type",
                  "value": "true",
                  "description": "Must be true (returns stream data keyed by type name)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "id",
                  "description": "(Required) The identifier of the activity"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
